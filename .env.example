# NextAuth.js
# `npx auth secret` 等で生成する。Phase 1（固定devユーザー運用）では未設定でも動作する
AUTH_SECRET=

# Amazon Cognito（NextAuth.js Cognitoプロバイダ）
# infraリポジトリでUser Poolが払い出され次第設定する。Phase 1では未設定でよい
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=

# backend API（ielts-creater-backend）のプロキシ転送先。next.config.tsのrewritesで使用する。
# 未設定時はhttp://localhost:8080（`SPRING_PROFILES_ACTIVE=local ./gradlew bootRun`のデフォルト）
BACKEND_API_ORIGIN=
