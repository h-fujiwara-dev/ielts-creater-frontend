# NextAuth.js
# `npx auth secret` 等で生成する
AUTH_SECRET=

# Amazon Cognito（NextAuth.js Cognitoプロバイダ）
# infraリポジトリ terraform/envs/dev の `terraform output` で取得した値を設定する
# （user_pool_client_id / user_pool_client_secret / issuer_url / hosted_ui_domain）
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=
# Cognito Hosted UIのグローバルログアウト（GET /api/auth/cognito-logout）で使用（#00041）。
# <domain>.auth.<region>.amazoncognito.com の形式（プロトコルなし）
COGNITO_HOSTED_UI_DOMAIN=

# backend API（ielts-creater-backend）の接続先。next.config.tsのrewrites（ブラウザ→backend）と
# auth.tsのGET /api/v1/me呼び出し（サーバーサイド→backend）の両方で使用する。
# 未設定時はhttp://localhost:8080（`SPRING_PROFILES_ACTIVE=local ./gradlew bootRun`のデフォルト）
BACKEND_API_ORIGIN=

# Playwright E2Eテスト（#00047）専用。dev Cognito User Poolに事前準備したテストユーザーの
# 認証情報。準備手順・実行方法はREADME.md「Playwright E2Eテスト」節を参照
# E2E_USER_*: name属性設定済みの正常系テストユーザー（コアフロー・履歴一覧のテストで使用）
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# E2E_NAMELESS_USER_*: name属性を未設定のまま作成したテストユーザー（#00046の既知バグを
# 再現し、新規サインアップE2Eで検証するために使用）
E2E_NAMELESS_USER_EMAIL=
E2E_NAMELESS_USER_PASSWORD=
